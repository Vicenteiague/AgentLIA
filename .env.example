# ========================================================
# VARIÁVEIS DE AMBIENTE - LIA BOT (VERCEL & GITHUB)
# ========================================================

# 1. Chave da API do Google Gemini (Essencial para IA e Voz Multimodal)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="COLOQUE_SUA_CHAVE_GEMINI_AQUI"

# 2. Configurações do Webhook da Meta (WhatsApp Business Cloud API)
# Token de verificação criado por você (pode manter este padrão)
WHATSAPP_VERIFY_TOKEN="lia_token_whatsapp_2026"

# (Opcional) Token de Acesso Permanente gerado no Meta for Developers
# Usado para enviar mensagens automáticas de volta ao WhatsApp do cliente
WHATSAPP_ACCESS_TOKEN=""

# (Opcional) Identificador do número de telefone (Phone Number ID) no painel da Meta
WHATSAPP_PHONE_NUMBER_ID=""

# Número oficial de atendimento humano com DDI e DDD (ex: +55 67 99317-4612)
BUSINESS_PHONE="+55 67 99317-4612"

# 3. Informações da Empresa (Opcionais - possuem valores padrão automáticos)
COMPANY_NAME="Conectacard & Superlimpo"
BOT_NAME="LIA"
WEBSITE_CONECTACARD="https://conectacard.com.br"
WEBSITE_SUPERLIMPO="https://superlimpo.com.br"
CATALOG_URL="https://superlimpo.com.br/produtos"
